# Dependencies
/node_modules/

# Build output
/.next/
*.tsbuildinfo
next-env.d.ts

# Tests
/coverage/

# Env: secrets stay local, the template is committed
.env*
!.env.example

# Runtime data: image uploads, served by a route handler
/uploads/

# Logs and OS files
npm-debug.log*
.DS_Store
*.pem

# Tool caches
/.fallow/
/.playwright-mcp/
/.superpowers/

# Claude Code, per clone: restored skills, agents, worktrees, local settings
/.agents/
/.claude/agents/
/.claude/skills/*
!/.claude/skills/db-reset/
/.claude/worktrees/
/.claude/settings.local.json

# Docs: agent scratch, except real docs
/docs/*
!/docs/agents/
!/docs/adr/
