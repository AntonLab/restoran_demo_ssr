# Copy to .env.local and fill in. .env.local is git-ignored.

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/restoran_demo

# Admin account, created only by `npm run seed`. No default in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Base for links in emails (password reset).
APP_BASE_URL=http://localhost:3000

# Mail delivery: `log` prints each email to the server log (the emulator);
# `smtp` sends through nodemailer with the settings below.
MAIL_DELIVERY=log
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Restoran Demo <no-reply@example.com>
