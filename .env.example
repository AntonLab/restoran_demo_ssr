# Copy to .env.local and fill in. .env.local is git-ignored.

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/restoran_demo

# Number of reverse proxies in front of the app. Unset: x-forwarded-for is ignored
# and every client shares one rate-limit bucket (fine for a local demo).
# TRUST_PROXY=1

# Admin account, created only by `npm run seed`. No default in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Base for links in emails (password reset).
APP_BASE_URL=http://localhost:3000

# Mail delivery: only `log` exists; it prints each email to the server log (the emulator).
MAIL_DELIVERY=log
